<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".rewards.Reward4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#38A9F5"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivRegresarRew4"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:src="@drawable/icon_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/regresar"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fondos -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Escenarios"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:paddingBottom="12dp"/>

                    <!-- Menú horizontal -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Escenario 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Esc1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_esc1_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Escenario 2 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Esc2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_esc2_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Escenario 3 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Esc3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_esc3_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Escenario 4 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Esc4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_esc4_locked"/>

                            </com.google.android.material.card.MaterialCardView>


                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recompensa -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReward4"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivReward4"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/reward4_hada0"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Color -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Color del cabello y hadas"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:paddingBottom="12dp"/>

                    <!-- Menú horizontal -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Color 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4C1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_c1_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Color 2 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4C2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_c2_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Color 3 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4C3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_c3_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Color 4 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4C4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_c4_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Ropa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#38A9F5"
                app:strokeWidth="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Color de la ropa"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:paddingBottom="12dp"/>

                    <!-- Menú horizontal -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Ropa 1 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Rp1"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_r1_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Ropa 2 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Rp2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_r2_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Ropa 3 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Rp3"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_r3_locked"/>

                            </com.google.android.material.card.MaterialCardView>


                            <!-- Ropa 4 -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="120dp"
                                android:layout_height="120dp"
                                android:layout_margin="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="6dp"
                                app:strokeColor="#38A9F5"
                                app:strokeWidth="2dp">

                                <ImageView
                                    android:id="@+id/ivRew4Rp4"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/reward4_r4_locked"/>

                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </HorizontalScrollView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>